<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ITIP — Definition Detail</title>
  <link rel="stylesheet" href="../itip-design-system.css">
  <style>
    .detail-grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: var(--sp-xl);
      align-items: start;
    }

    .kv {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: var(--sp-sm) var(--sp-md);
      font-size: var(--fs-sm);
    }

    .kv .k {
      color: var(--itip-text-muted);
    }

    /* SVG edge layer for UML connectors */
    #arc-edges {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: visible;
    }
    #arc-list {
      position: relative;
      z-index: 1;
    }

    /* Archetype contribution row — one per archetype that STRUCTURES the statement */
    .arc-card {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: var(--sp-md);
      padding: var(--sp-md);
      border: 1px solid var(--itip-border);
      border-left-width: 4px;
      border-radius: var(--radius-md);
      margin-bottom: var(--sp-sm);
      background: var(--itip-surface);
    }

    .arc-card__rail {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-right: var(--sp-sm);
      border-right: 1px dashed var(--itip-border);
    }

    .arc-card__rail .arc-badge {
      width: 100%;
      justify-content: center;
    }

    .arc-card__rail .arc-card__uri {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--itip-text-muted);
      word-break: break-all;
      line-height: 1.3;
    }

    .arc-card__body {
      min-width: 0;
    }

    .arc-card__title {
      font-weight: 600;
      font-size: var(--fs-sm);
      margin-bottom: var(--sp-xs);
    }

    .arc-card__field {
      font-size: var(--fs-xs);
      color: var(--itip-text-muted);
      margin-top: 2px;
    }

    .arc-card--highlight {
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--itip-primary) 35%, transparent);
      transition: box-shadow 0.12s ease;
    }

    /* Statement composition tree connectors.
       UML semantics:
       - .arc-extends uses generalization-style connectors ($ref / Is a)
       - .arc-facets uses composition-style connectors (allOf / Has a) */
    /* Tree connector containers: no visual decoration — SVG edges rendered via JS. */
    .arc-extends {
      margin: 6px 0 var(--sp-sm) 22px;
      padding: 6px 0 6px 30px;
      position: relative;
    }
    .arc-extends .arc-card {
      position: relative;
    }

    /* UML composition connector from parent archetype to allOf facet rail. */
    .arc-facets {
      margin: 6px 0 var(--sp-sm) 22px;
      padding: 6px 0 6px 30px;
      position: relative;
    }
    .arc-facets .arc-card {
      position: relative;
    }
    .arc-facets .arc-card {
      position: relative;
    }

    /* Archetype graph (sidebar) */
    .arc-graph {
      background: var(--itip-bg);
      border: 1px solid var(--itip-border);
      border-radius: var(--radius-md);
      padding: var(--sp-sm);
    }
    .arc-graph svg .arc-graph__node rect {
      transition: filter 0.15s ease, transform 0.05s ease;
    }
    .arc-graph svg .arc-graph__node:hover rect {
      filter: brightness(0.94);
    }
    .arc-graph svg .arc-graph__node:active rect {
      transform: translateY(1px);
    }

    /* Ascription switcher — vertical list in right sidebar */
    .asc-switcher {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .asc-pill {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: 'id state' 'created created';
      column-gap: var(--sp-sm);
      row-gap: 2px;
      padding: 8px 10px;
      border: 1px solid var(--itip-border);
      border-left: 3px solid var(--itip-border);
      border-radius: var(--radius-md);
      background: var(--itip-surface);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
      position: relative;
    }
    .asc-pill:hover { border-color: var(--itip-primary); background: color-mix(in srgb, var(--itip-primary) 3%, var(--itip-surface)); }
    .asc-pill--current {
      border-color: var(--itip-primary);
      border-left-color: var(--itip-primary);
      border-left-width: 3px;
      background: color-mix(in srgb, var(--itip-primary) 5%, var(--itip-surface));
      box-shadow: 0 1px 3px color-mix(in srgb, var(--itip-primary) 15%, transparent);
    }
    .asc-pill--current::before {
      content: '';
      position: absolute;
      left: -8px; top: 50%; transform: translateY(-50%);
      width: 0; height: 0;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-right: 6px solid var(--itip-primary);
    }
    .asc-pill__id {
      grid-area: id;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--itip-text);
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .asc-pill__state { grid-area: state; }
    .asc-pill__state .stmt-state { font-size: 10px; padding: 1px 6px; }
    .asc-pill__created {
      grid-area: created;
      font-size: 11px;
      color: var(--itip-text-muted);
      line-height: 1.3;
    }
    .asc-sidebar-card .card-title {
      display: flex; align-items: baseline; gap: var(--sp-xs);
    }
    .asc-sidebar-card .asc-count-badge {
      font-size: 11px;
      color: var(--itip-text-muted);
      font-weight: 400;
    }

    /* Ascription compare mode (diff selection) */
    .asc-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-sm);
      margin-bottom: var(--sp-xs);
    }
    .asc-card-header .card-title { margin: 0; }
    .asc-compare-toggle {
      font-size: 11px;
      font-weight: 500;
      padding: 3px 8px;
      border: 1px solid var(--itip-border);
      border-radius: var(--radius-md);
      background: var(--itip-surface);
      color: var(--itip-text-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.12s ease;
    }
    .asc-compare-toggle:hover { color: var(--itip-text); border-color: var(--itip-primary); }
    .asc-compare-toggle--on {
      background: var(--itip-primary);
      border-color: var(--itip-primary);
      color: #fff;
    }
    .asc-compare-toggle--on:hover { color: #fff; }
    /* Selector sits on the right of the pill (absolute) so it doesn't disturb the
       2-row grid used in navigate mode. */
    .asc-pill__check {
      position: absolute;
      top: 50%;
      right: 10px;
      transform: translateY(-50%);
      width: 16px; height: 16px;
      border: 1.5px solid var(--itip-border);
      border-radius: 4px;
      background: var(--itip-surface);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 11px;
      line-height: 1;
      flex-shrink: 0;
      pointer-events: none;
    }
    /* In compare mode, reserve room on the right so the state pill / id text don't
       collide with the checkbox. */
    .asc-switcher--compare .asc-pill {
      cursor: pointer;
      padding-right: 36px;
      text-align: left;
      font: inherit;
    }
    .asc-switcher--compare .asc-pill:focus-visible {
      outline: 2px solid var(--itip-primary);
      outline-offset: 1px;
    }
    .asc-pill--selected {
      border-color: var(--itip-primary);
      background: color-mix(in srgb, var(--itip-primary) 7%, var(--itip-surface));
    }
    .asc-pill--selected .asc-pill__check {
      background: var(--itip-primary);
      border-color: var(--itip-primary);
    }
    .asc-diff-toolbar[hidden] { display: none !important; }
    .asc-diff-toolbar {
      margin-top: var(--sp-sm);
      padding: var(--sp-sm);
      border: 1px dashed var(--itip-border);
      border-radius: var(--radius-md);
      background: var(--itip-bg);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .asc-diff-toolbar__hint {
      font-size: 11px;
      color: var(--itip-text-muted);
      line-height: 1.4;
    }
    .asc-diff-toolbar__pair {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--itip-text);
      word-break: break-all;
    }
    .asc-diff-toolbar__pair .asc-diff-arrow { color: var(--itip-text-muted); margin: 0 4px; }
    .asc-diff-toolbar__actions {
      display: flex; gap: 6px;
    }
    .asc-diff-toolbar__btn {
      font-size: 11px;
      font-weight: 500;
      padding: 4px 10px;
      border-radius: var(--radius-md);
      border: 1px solid var(--itip-border);
      background: var(--itip-surface);
      color: var(--itip-text);
      cursor: pointer;
    }
    .asc-diff-toolbar__btn:hover { border-color: var(--itip-primary); }
    .asc-diff-toolbar__btn--primary {
      background: var(--itip-primary);
      border-color: var(--itip-primary);
      color: #fff;
    }
    .asc-diff-toolbar__btn--primary:disabled {
      opacity: 0.4; cursor: not-allowed;
    }

    /* Status state machine — compact SVG for the right sidebar.
       Layout: main vertical spine (Draft → Proposed → Approved → Active → Deprecated → Retired)
       with side branches for Abandoned, Rejected (top terminals) and a Suspended ↔ Active loop. */
    #sm-machine {
      display: flex;
      justify-content: center;
    }
    .sm-machine-stage {
      position: relative;
      display: inline-block;
      padding: 4px;
      background: var(--itip-bg);
      border: 1px solid var(--itip-border);
      border-radius: var(--radius-md);
      box-sizing: border-box;
    }
    .sm-svg {
      width: auto;
      height: auto;
      display: block;
      shape-rendering: geometricPrecision;
    }
    .sm-node rect {
      fill: var(--itip-surface);
      stroke: #8b949e;
      stroke-width: 1.25;
      transition: stroke 0.15s, fill 0.15s;
    }
    .sm-node text {
      display: none;
    }
    .sm-node-label {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
      font-size: 11px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0;
      color: var(--itip-text);
      text-transform: uppercase;
      pointer-events: none;
      user-select: none;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .sm-node-label--current { color: #0d6efd; font-weight: 700; }
    .sm-node-label--reachable { color: #15803d; font-weight: 600; }
    .sm-node-label--terminal { color: #6e7681; }
    .sm-node--terminal rect {
      fill: #f6f8fa;
      stroke: #8b949e;
      stroke-dasharray: 5 3;
    }
    .sm-node--terminal text { fill: #6e7681; }
    .sm-node--reachable { cursor: pointer; }
    .sm-node--reachable rect {
      stroke: #22c55e;
      stroke-width: 1.75;
      stroke-dasharray: 5 3;
      fill: rgba(34,197,94,0.06);
    }
    .sm-node--reachable:hover rect {
      stroke: #16a34a;
      fill: rgba(34,197,94,0.16);
    }
    .sm-node--reachable text { fill: #15803d; font-weight: 600; }
    .sm-node--current rect {
      stroke: #0d6efd;
      stroke-width: 2.25;
      fill: rgba(13,110,253,0.12);
    }
    .sm-node--current text { fill: #0d6efd; font-weight: 600; }
    .sm-edge {
      fill: none;
      stroke: #8b949e;
      stroke-width: 1.25;
    }
    .sm-edge--reachable {
      stroke: #22c55e;
      stroke-width: 1.75;
    }

    /* Older linear lc-machine kept for backwards compat but no longer rendered. */
    .lc-node {
      display: grid;
      grid-template-columns: 16px 1fr auto;
      align-items: center;
      gap: var(--sp-sm);
      padding: 6px 10px;
      border: 1px solid var(--itip-border);
      border-radius: var(--radius-md);
      background: var(--itip-surface);
      text-decoration: none;
      color: inherit;
      font-size: var(--fs-xs);
      transition: border-color 0.15s, background 0.15s;
    }
    .lc-node--current {
      border-color: var(--itip-primary);
      background: color-mix(in srgb, var(--itip-primary) 5%, var(--itip-surface));
      font-weight: 600;
    }
    .lc-node--reachable {
      border-color: color-mix(in srgb, var(--itip-primary) 50%, var(--itip-border));
      border-style: dashed;
      cursor: pointer;
    }
    .lc-node--reachable:hover {
      background: color-mix(in srgb, var(--itip-primary) 8%, var(--itip-surface));
      border-color: var(--itip-primary);
    }
    .lc-node--blocked {
      opacity: 0.5;
      color: var(--itip-text-muted);
    }
    .lc-node__dot {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--itip-border);
      justify-self: center;
    }
    .lc-node--current .lc-node__dot { background: var(--itip-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--itip-primary) 25%, transparent); }
    .lc-node--reachable .lc-node__dot { background: color-mix(in srgb, var(--itip-primary) 50%, var(--itip-border)); }
    .lc-node__name { font-family: var(--font-mono); }
    .lc-node__tag {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 1px 6px;
      border-radius: 3px;
      border: 1px solid;
    }
    .lc-tag--current { background: var(--itip-primary); color: white; border-color: var(--itip-primary); }
    .lc-tag--reachable { background: color-mix(in srgb, var(--itip-primary) 10%, transparent); color: var(--itip-primary); border-color: color-mix(in srgb, var(--itip-primary) 40%, transparent); }
    .lc-tag--terminal { background: #f3f4f6; color: #6b7280; border-color: #d1d5db; }
    .lc-tag--blocked { background: transparent; color: var(--itip-text-muted); border-color: var(--itip-border); }
    .lc-arrow {
      align-self: center;
      justify-self: center;
      color: var(--itip-text-muted);
      font-size: 10px;
      margin: -2px 0;
    }
    .lc-arrow--reachable { color: var(--itip-primary); }

    /* Slot annotations panel */
    .slot-row { cursor: default; }
    .slot-key__toggle {
      display: inline-block;
      width: 12px;
      color: var(--itip-text-muted);
      font-family: var(--font-mono);
      cursor: pointer;
      user-select: none;
      margin-right: 2px;
    }
    .slot-key__toggle:hover { color: var(--itip-primary); }
    .slot-meta {
      grid-column: 1 / -1;
      margin-top: 4px;
      padding: var(--sp-sm) var(--sp-md);
      background: color-mix(in srgb, var(--itip-primary) 3%, var(--itip-bg));
      border: 1px dashed var(--itip-border);
      border-radius: var(--radius-md);
      display: none;
    }
    .slot-meta--open { display: grid; gap: 4px; grid-template-columns: 160px 1fr; }
    .slot-meta__k {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--itip-text-muted);
      white-space: nowrap;
    }
    .slot-meta__v {
      font-size: var(--fs-xs);
      color: var(--itip-text);
      word-break: break-word;
    }
    .slot-meta__v code {
      font-family: var(--font-mono);
      background: var(--itip-surface);
      padding: 1px 5px;
      border-radius: 3px;
      border: 1px solid var(--itip-border);
      font-size: 10px;
    }
    .slot-meta__bool--yes { color: #15803d; font-weight: 600; }
    .slot-meta__bool--no { color: var(--itip-text-muted); }

    /* Slot table — strict archetype-defined fields */
    .slot-table {
      /* No top border: arc-card body has no preceding title, so a top rule would
         look like an empty dashed header. Rows use their own separators below. */
    }
    .slot-row {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: var(--sp-sm);
      align-items: baseline;
      padding: 4px 0;
      font-size: var(--fs-xs);
    }
    .slot-row + .slot-row { border-top: 1px dashed color-mix(in srgb, var(--itip-border) 40%, transparent); }
    .slot-key {
      font-family: var(--font-mono);
      color: var(--itip-text);
      font-weight: 600;
    }
    .slot-value { color: var(--itip-text); word-break: break-all; }
    .slot-val {
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 1px 5px;
      background: var(--itip-bg);
      border: 1px solid var(--itip-border);
      border-radius: 3px;
      margin-right: 3px;
      display: inline-block;
    }
    .slot-val--name {
      font-weight: 700;
      font-size: 12px;
      color: var(--itip-text);
    }

    .arc-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: var(--fs-xs);
      line-height: 1.4;
      font-weight: 500;
      border: 1px solid;
    }

    .arc-badge--gsm {
      background: color-mix(in srgb, var(--itip-primary) 10%, transparent);
      color: var(--itip-primary);
      border-color: color-mix(in srgb, var(--itip-primary) 25%, transparent);
    }

    /* Navigator chip: clickable archetype pill that scrolls to its card */
    .arc-nav-chip {
      cursor: pointer;
      font-family: inherit;
      transition: filter 0.15s ease, transform 0.05s ease;
    }
    .arc-nav-chip:hover {
      filter: brightness(0.96);
      text-decoration: none;
    }
    .arc-nav-chip:active {
      transform: translateY(1px);
    }
    .arc-nav-target {
      scroll-margin-top: 80px;
    }

    .arc-badge--togaf {
      background: #eff6ff;
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    .arc-badge--swtech {
      background: #f1f5f9;
      color: #475569;
      border-color: #cbd5e1;
    }

    .arc-badge--iso {
      background: #f0fdf4;
      color: #15803d;
      border-color: #bbf7d0;
    }

    .arc-badge--nis2 {
      background: #fef2f2;
      color: #b91c1c;
      border-color: #fecaca;
    }

    .arc-badge--gdpr {
      background: #faf5ff;
      color: #7c3aed;
      border-color: #ddd6fe;
    }

    .arc-badge--scap {
      background: #fefce8;
      color: #a16207;
      border-color: #fde68a;
    }

    .norm-row {
      display: grid;
      grid-template-columns: 1fr 100px 90px;
      gap: var(--sp-sm);
      align-items: center;
      padding: var(--sp-sm) 0;
      border-bottom: 1px dashed var(--itip-border);
      font-size: var(--fs-sm);
    }

    .norm-row:last-child {
      border-bottom: none;
    }

    .norm-row__name {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
    }

    .timeline {
      position: relative;
      padding-left: var(--sp-lg);
      border-left: 2px solid var(--itip-border);
      margin-top: var(--sp-sm);
    }

    .timeline-item {
      position: relative;
      padding-bottom: var(--sp-md);
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: calc(-1 * var(--sp-lg) - 6px);
      top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--itip-primary);
      border: 2px solid var(--itip-surface);
    }

    .timeline-item--current::before {
      background: #22c55e;
    }

    .timeline-time {
      font-size: var(--fs-xs);
      color: var(--itip-text-muted);
    }

    .timeline-title {
      font-size: var(--fs-sm);
      font-weight: 600;
    }

    /* Per-statement lifecycle controls */
    .stmt-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-md);
      flex-wrap: wrap;
    }
    .stmt-header__title {
      display: flex;
      align-items: center;
      gap: var(--sp-sm);
    }
    .stmt-state {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border: 1px solid;
    }

    .stmt-state--draft {
      background: #f3f4f6;
      color: #4b5563;
      border-color: #d1d5db;
    }

    .stmt-state--proposed {
      background: #eff6ff;
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    .stmt-state--approved {
      background: #f5f3ff;
      color: #6d28d9;
      border-color: #ddd6fe;
    }

    .stmt-state--active {
      background: #f0fdf4;
      color: #15803d;
      border-color: #bbf7d0;
    }

    .stmt-state--suspended {
      background: #fefce8;
      color: #a16207;
      border-color: #fde68a;
    }

    .stmt-state--deprecated {
      background: #fff7ed;
      color: #c2410c;
      border-color: #fed7aa;
    }

    .stmt-state--retired {
      background: #f3f4f6;
      color: #6b7280;
      border-color: #d1d5db;
      text-decoration: line-through;
    }

    .stmt-state--rejected {
      background: #fef2f2;
      color: #b91c1c;
      border-color: #fecaca;
    }

    .stmt-state--abandoned {
      background: #f3f4f6;
      color: #6b7280;
      border-color: #d1d5db;
      font-style: italic;
    }

    .stmt-actions {
      display: flex;
      gap: 6px;
      margin-top: var(--sp-sm);
      padding-top: var(--sp-sm);
      border-top: 1px dashed var(--itip-border);
      align-items: center;
      flex-wrap: wrap;
    }

    .stmt-actions .text-xs {
      margin-right: auto;
    }

    /* Definition view tabs (main column) */
    .deftabs {
      display: flex;
      flex-wrap: wrap;
      gap: 2px;
      border-bottom: 1px solid var(--itip-border);
      margin-bottom: var(--sp-md);
    }
    .deftab {
      appearance: none;
      background: transparent;
      border: 1px solid transparent;
      border-bottom: none;
      padding: 8px 14px;
      font: inherit;
      font-size: var(--fs-sm);
      color: var(--itip-text-muted);
      cursor: pointer;
      border-top-left-radius: var(--radius-md);
      border-top-right-radius: var(--radius-md);
      transition: background 0.12s, color 0.12s, border-color 0.12s;
      margin-bottom: -1px;
    }
    .deftab:hover { color: var(--itip-text); background: var(--itip-bg); }
    .deftab--active {
      color: var(--itip-text);
      background: var(--itip-surface);
      border-color: var(--itip-border);
      border-bottom-color: var(--itip-surface);
      font-weight: 600;
    }
    .deftabpanel { display: none; }
    .deftabpanel--active { display: block; }

    /* Schema graph (depth-1 placeholder) */
    .schema-graph {
      background: var(--itip-bg);
      border: 1px solid var(--itip-border);
      border-radius: var(--radius-md);
      padding: var(--sp-md);
    }
    .schema-graph__svg { width: 100%; height: 360px; display: block; }
    .schema-graph__legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-md);
      margin-top: var(--sp-sm);
      font-size: var(--fs-xs);
      color: var(--itip-text-muted);
    }
    .schema-graph__legend__swatch {
      display: inline-block;
      width: 10px; height: 10px;
      border-radius: 2px;
      margin-right: 4px;
      vertical-align: middle;
    }

    /* ---- Status transition tab (from ascription-transition.html) ---- */
    .transition-panel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-xl);
      align-items: start;
    }
    .transition-panel .card { padding: var(--sp-lg); }
    .transition-panel .card + .card { margin-top: var(--sp-lg); }
    .sm-legend { display: flex; gap: var(--sp-lg); flex-wrap: wrap; margin-top: var(--sp-sm); font-size: var(--fs-xs); color: var(--itip-text-muted); }
    .sm-legend-item { display: flex; align-items: center; gap: var(--sp-xs); }
    .sm-legend-swatch { width: 14px; height: 14px; border-radius: 4px; border: 2px solid; }
    .sm-legend-swatch--current  { border-color: #0d6efd; background: rgba(13,110,253,0.12); }
    .sm-legend-swatch--target   { border-color: #22c55e; background: rgba(34,197,94,0.12); }
    .sm-legend-swatch--terminal { border-color: #8b949e; background: #f6f8fa; border-style: dashed; }
    .transition-from-to { display: flex; align-items: center; gap: var(--sp-md); margin-bottom: var(--sp-lg); }
    .transition-badge { padding: var(--sp-xs) var(--sp-md); border-radius: var(--radius-full, 999px); font-size: var(--fs-sm); font-weight: 600; border: 2px solid; }
    .transition-badge--from { border-color: #0d6efd; background: rgba(13,110,253,0.1); color: #0d6efd; }
    .transition-badge--to   { border-color: #22c55e; background: rgba(34,197,94,0.1); color: #16a34a; }
    .rule-section { margin-bottom: var(--sp-lg); }
    .rule-section:last-child { margin-bottom: 0; }
    .rule-section h4 { font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--sp-sm); display: flex; align-items: center; gap: var(--sp-sm); }
    .rule-count { font-size: var(--fs-xs); padding: 1px 8px; border-radius: var(--radius-full, 999px); background: var(--itip-bg-muted, #f6f8fa); color: var(--itip-text-muted); font-weight: 500; }
    .evaluation-checks { list-style: none; padding: 0; margin: 0; }
    .evaluation-checks li { display: flex; align-items: flex-start; gap: var(--sp-sm); padding: var(--sp-sm) 0; border-bottom: 1px solid var(--itip-border); font-size: var(--fs-sm); }
    .evaluation-checks li:last-child { border-bottom: none; }
    .check-icon { width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; margin-top: 1px; color: #fff; }
    .check-icon--pass { background: var(--compliance-pass, #22c55e); }
    .check-icon--fail { background: var(--compliance-fail, #ef4444); }
    .check-icon--warn { background: var(--compliance-warn, #f59e0b); }
    .check-icon--na   { background: var(--itip-border); color: var(--itip-text-muted); }
    .cascade-type { font-size: var(--fs-xs); padding: 1px 6px; border-radius: var(--radius-sm, 4px); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .cascade-type--constitutive { background: rgba(239,68,68,0.1); color: #dc2626; }
    .cascade-type--governing    { background: rgba(59,130,246,0.1); color: #2563eb; }
    .cascade-type--dependent    { background: rgba(245,158,11,0.1); color: #d97706; }
  </style>
</head>

<body>
  <div class="app-shell">

    <!-- Sidebar (regenerated by /tmp/regen_sidebar.py — active=registry) -->
    <aside class="app-sidebar">
      <div class="app-sidebar__logo"><span class="logo-icon">AC</span> ACME Corp</div>
      <nav class="app-sidebar__nav">
        <div class="nav-section">Definition</div>
        <a class="nav-item" href="../definition/def-dashboard.html">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          Dashboard
        </a>
        <a class="nav-item active" href="../definition/registry.html">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M3 6h18M3 12h18M3 18h18" />
            <circle cx="7" cy="6" r="1.5" fill="currentColor" />
            <circle cx="7" cy="12" r="1.5" fill="currentColor" />
            <circle cx="7" cy="18" r="1.5" fill="currentColor" />
          </svg>
          Registry
        </a>
        <div class="nav-section">Frameworks</div>
        <a class="nav-item" href="../frameworks/catalog.html">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4 19.5A2.5 2.5 0 016.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" />
          </svg>
          Catalog <span class="nav-badge">5</span>
        </a>
        <a class="nav-item" href="../frameworks/stack-composer.html">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M12 8v8M8 12h8" />
          </svg>
          Stack Composer
        </a>
      </nav>
      <div class="app-sidebar__footer">
        <span>IT Intelligence Platform</span>
        <span>by <strong>Poesis</strong> &middot; &copy; 2024&ndash;2026</span>
      </div>
    </aside>

    <header class="app-header">
      <div class="app-header__breadcrumb">
        <span>Definition</span><span>/</span>
        <a href="registry.html">Registry</a><span>/</span>
        <strong id="bc-subject">API Gateway</strong>
      </div>
      <div class="app-header__actions">
        <button class="btn btn--copilot btn--sm">✦ Copilot Assist</button>
        <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
          <svg class="theme-icon--light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5" />
            <path
              d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg class="theme-icon--dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>
        <div class="avatar">EA</div>
      </div>
    </header>

    <main class="app-main">

      <h1 class="page-title" style="display:flex;align-items:center;gap:var(--sp-md);flex-wrap:wrap">
        <span id="title-subject">API Gateway</span>
      </h1>

      <div class="detail-grid">

        <!-- Left column: tabbed views -->
        <div>
          <div class="deftabs" role="tablist" id="def-tabs">
            <button type="button" class="deftab deftab--active" role="tab" data-deftab="statement">Statement</button>
            <button type="button" class="deftab" role="tab" data-deftab="schema">Diagram</button>
            <button type="button" class="deftab" role="tab" data-deftab="governance">Governance</button>
            <button type="button" class="deftab" role="tab" data-deftab="status">Status transition</button>
            <button type="button" class="deftab" role="tab" data-deftab="activity">Activity</button>
          </div>

          <section class="deftabpanel deftabpanel--active" id="deftabpanel-statement" role="tabpanel">
            <div class="card">
              <div class="card__body">
                <div class="stmt-header">
                  <div class="stmt-header__title">
                    <h2 class="card-title" style="margin:0">Statement</h2>
                  </div>
                </div>
                <p class="text-xs text-muted mb-md">One ascription carries one statement. The statement begins with the base archetype (the GSM primitive itself) and is then extended by domain archetypes — each contributing structural fields and norms.</p>
                <div style="position:relative;">
                  <svg id="arc-edges"></svg>
                  <div id="arc-list"></div>
                </div>
              </div>
            </div>
          </section>

          <section class="deftabpanel" id="deftabpanel-schema" role="tabpanel">
            <div class="card">
              <div class="card__body">
                <h2 class="card-title">Schema</h2>
                <p class="text-xs text-muted mb-md">Structural view of the subject and its directly related primitives (Structure / Mechanism / Interaction). Depth = 1 by default.</p>
                <div class="schema-graph">
                  <svg id="schema-graph-svg" class="schema-graph__svg" xmlns="http://www.w3.org/2000/svg"></svg>
                </div>
                <div class="schema-graph__legend">
                  <span><span class="schema-graph__legend__swatch" style="background:var(--itip-primary)"></span>Subject (this definition)</span>
                  <span><span class="schema-graph__legend__swatch" style="background:#64748b"></span>Related subject</span>
                  <span><span class="schema-graph__legend__swatch" style="background:transparent;border:1px solid var(--itip-text-muted)"></span>Interaction (edge)</span>
                </div>
              </div>
            </div>
          </section>

          <section class="deftabpanel" id="deftabpanel-governance" role="tabpanel">
            <div class="card">
              <div class="card__body">
                <h2 class="card-title">Norms in effect</h2>
                <p class="text-xs text-muted mb-md">DNA governance: norms aggregated across all archetypes contributing to this ascription. A norm fails if any of its evaluations fails.</p>
                <div class="norm-row" style="font-weight:600;color:var(--itip-text-muted);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:0.04em">
                  <span>Norm</span>
                  <span style="text-align:center">From</span>
                  <span style="text-align:center">State</span>
                </div>
                <div id="norm-list"></div>
              </div>
            </div>
          </section>

          <section class="deftabpanel" id="deftabpanel-status" role="tabpanel">
            <p class="text-xs text-muted" style="margin:0 0 var(--sp-md) 0">Click a reachable state on the lifecycle state machine in the sidebar to stage a transition, then review and confirm here.</p>
            <div>
                <div class="card">
                  <div class="card__body">
                  <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--sp-md); margin-bottom:var(--sp-md); flex-wrap:wrap">
                    <h3 style="margin:0">Transition evaluation</h3>
                    <div class="transition-from-to" style="margin:0">
                      <span class="transition-badge transition-badge--from" id="tx-from">APPROVED</span>
                      <span style="color:var(--itip-text-muted); font-size:var(--fs-lg)">→</span>
                      <span class="transition-badge transition-badge--to" id="tx-to">ACTIVE</span>
                    </div>
                  </div>
                  <div class="rule-section">
                    <h4>Reference Preconditions <span class="rule-count">1 check</span></h4>
                    <p style="font-size:var(--fs-xs); color:var(--itip-text-muted); margin-bottom:var(--sp-sm)" id="tx-precond-desc">APPROVED → ACTIVE requires each reference in <strong>ACTIVE</strong></p>
                    <ul class="evaluation-checks">
                      <li>
                        <span class="check-icon check-icon--pass">✓</span>
                        <div><strong>Structure</strong> → PaymentGateway<br><span class="text-muted text-xs">Status: ACTIVE — meets requirement</span></div>
                      </li>
                    </ul>
                  </div>
                  <div class="rule-section">
                    <h4>Inter-Transition Cascades <span class="rule-count">2 cascades</span></h4>
                    <ul class="evaluation-checks">
                      <li>
                        <span class="check-icon check-icon--pass">✓</span>
                        <div>
                          <strong>Effector</strong> → terminate_ssl &ensp;<span class="cascade-type cascade-type--constitutive">constitutive</span>
                          <br><span class="text-muted text-xs">APPROVED → ACTIVE — preconditions met (Archetype ref: ACTIVE)</span>
                          <br><span class="text-muted text-xs" style="color:#dc2626">Blocking — failure rejects source transition</span>
                        </div>
                      </li>
                      <li>
                        <span class="check-icon check-icon--pass">✓</span>
                        <div>
                          <strong>Receptor</strong> → https_endpoint &ensp;<span class="cascade-type cascade-type--constitutive">constitutive</span>
                          <br><span class="text-muted text-xs">APPROVED → ACTIVE — preconditions met (Archetype ref: ACTIVE)</span>
                          <br><span class="text-muted text-xs" style="color:#dc2626">Blocking — failure rejects source transition</span>
                        </div>
                      </li>
                    </ul>
                  </div>
                  <div class="rule-section">
                    <h4>Intra-Definition Rules <span class="rule-count">1 effect</span></h4>
                    <ul class="evaluation-checks">
                      <li>
                        <span class="check-icon check-icon--warn">!</span>
                        <div>
                          <strong>Activation Handoff</strong>
                          <br><span class="text-muted text-xs"><span class="text-mono">MEC-0037-v1</span> (ACTIVE) → will be auto-DEPRECATED</span>
                          <br><span class="text-muted text-xs">Preserves invariant: at most one ACTIVE per Definition</span>
                        </div>
                      </li>
                    </ul>
                  </div>
                  <div style="display:flex; gap:var(--sp-md); justify-content:flex-end; margin-top:var(--sp-md); padding-top:var(--sp-md); border-top:1px solid var(--itip-border)">
                    <button type="button" class="btn btn--secondary" id="tx-cancel-btn">Reset</button>
                    <button type="button" class="btn btn--primary" id="tx-confirm-btn">Confirm transition</button>
                  </div>
                  <div id="tx-confirm-banner" hidden style="margin-top:var(--sp-md); padding:var(--sp-sm) var(--sp-md); border-radius:var(--radius-md); background:rgba(34,197,94,0.1); color:#16a34a; font-size:var(--fs-sm); border:1px solid #22c55e">
                    Transition confirmed (mock). Backend call would be issued here.
                  </div>
                  </div>
                </div>
            </div>
          </section>

          <section class="deftabpanel" id="deftabpanel-activity" role="tabpanel">
            <div class="card">
              <div class="card__body">
                <h2 class="card-title">Activity</h2>
                <p class="text-xs text-muted mb-md">Timeline of definition / ascription events for this subject.</p>
                <div class="timeline" id="activity-list"></div>
              </div>
            </div>
          </section>
        </div>

        <!-- Right column: ascriptions switcher, status, provenance, authorship -->
        <aside>
          <section class="card mb-lg asc-sidebar-card">
            <div class="card__body">
              <div class="asc-card-header">
                <h3 class="card-title">
                  Ascriptions
                  <span id="asc-count" class="asc-count-badge"></span>
                </h3>
                <button type="button" id="asc-compare-toggle" class="asc-compare-toggle" aria-pressed="false" title="Select two ascriptions to compare">
                  <span aria-hidden="true">⇄</span> Compare
                </button>
              </div>
              <p class="text-xs text-muted" id="asc-hint" style="margin:-4px 0 var(--sp-sm) 0">Switch between historical and current ascriptions of this subject.</p>
              <div class="asc-switcher" id="asc-switcher"></div>
              <div class="asc-diff-toolbar" id="asc-diff-toolbar" hidden>
                <div class="asc-diff-toolbar__hint" id="asc-diff-hint">Select two ascriptions to compare.</div>
                <div class="asc-diff-toolbar__pair" id="asc-diff-pair" hidden></div>
                <div class="asc-diff-toolbar__actions">
                  <button type="button" class="asc-diff-toolbar__btn asc-diff-toolbar__btn--primary" id="asc-diff-open" disabled>Open diff</button>
                  <button type="button" class="asc-diff-toolbar__btn" id="asc-diff-clear">Clear</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card mb-lg">
            <div class="card__body">
              <h3 class="card-title" style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-sm)">
                <span>Status</span>
                <span id="lc-current-pill" class="stmt-state stmt-state--active">Active</span>
              </h3>
              <div id="sm-machine"></div>
              <div class="sm-legend" style="margin-top:var(--sp-sm)">
                <div class="sm-legend-item"><div class="sm-legend-swatch sm-legend-swatch--current"></div> Current</div>
                <div class="sm-legend-item"><div class="sm-legend-swatch sm-legend-swatch--target"></div> Reachable</div>
                <div class="sm-legend-item"><div class="sm-legend-swatch sm-legend-swatch--terminal"></div> Terminal</div>
              </div>
            </div>
          </section>

          <section class="card mb-lg">
            <div class="card__body">
              <h3 class="card-title">Provenance</h3>
              <div class="kv">
                <div class="k">Sourced via</div>
                <div id="prov-source" class="text-xs">CMDB sync</div>
                <div class="k">Ascribed by</div>
                <div id="prov-ascribed" class="text-xs">E. Adams (Architect)</div>
                <div class="k">Confidence</div>
                <div id="prov-confidence" class="text-xs">0.97</div>
                <div class="k">Last attestation</div>
                <div id="prov-attested" class="text-xs text-muted">2026-04-12</div>
              </div>
            </div>
          </section>

          <section class="card">
            <div class="card__body">
              <h3 class="card-title">Authorship</h3>
              <div class="kv">
                <div class="k">Owner</div>
                <div id="auth-owner" class="text-xs">Platform Engineering</div>
                <div class="k">Created</div>
                <div id="auth-created" class="text-xs text-muted">2024-09-15 by E. Adams</div>
                <div class="k">Last updated</div>
                <div id="auth-updated" class="text-xs text-muted">2026-04-12 by R. Singh</div>
              </div>
            </div>
          </section>
        </aside>

      </div>

    </main>
  </div>

  <button class="copilot-toggle" title="Copilot Agent">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
    </svg>
    <span class="copilot-toggle__badge">✦</span>
  </button>

  <script>
    (function () { var t = localStorage.getItem('itip-theme') || 'light'; document.documentElement.setAttribute('data-theme', t) })();
    function toggleTheme() { var c = document.documentElement.getAttribute('data-theme'), n = c === 'dark' ? 'light' : 'dark'; document.documentElement.setAttribute('data-theme', n); localStorage.setItem('itip-theme', n) }

    // ---- Mock subject data (one entry per registry row) ----
    // Each archetype contribution lists ONLY the slots that archetype defines.
    // A statement = the union of slot values across the archetypes that structure it.
    const SUBJECTS = {
      'api-gateway': {
        name: 'API Gateway', uri: 'acme:subject/api-gateway',
        state: 'active',
        ascriptions: [
          { id: 'asc-api-gateway-3', created: '2026-04-12 10:32 by R. Singh', state: 'active' },
          { id: 'asc-api-gateway-2', created: '2025-09-01 14:11 by E. Adams', state: 'deprecated' },
          { id: 'asc-api-gateway-1', created: '2024-09-15 09:00 by E. Adams', state: 'retired' },
        ],
        primitive: { gsm: 'gsm/Structure/v1', label: 'Structure · Application Component' },
        owner: 'Platform Engineering', created: '2024-09-15 by E. Adams', updated: '2026-04-12 by R. Singh',
        subtitle: 'Edge HTTP/gRPC entrypoint. Applied archetypes from TOGAF, SoftwareTechnology, ISO 25010, NIS2, SCAP.',
        archetypes: [
          {
            kind: 'togaf', name: 'TOGAF: LogicalApplicationComponent',
            uri: 'togaf:archetype/LogicalApplicationComponent/v9.2', since: '2024-09-15',
            slots: [
              { k: 'domain', t: 'enum', v: 'Application Architecture' },
              { k: 'component_type', t: 'enum', v: 'Logical' },
              { k: 'realises', t: 'ref[]', v: ['togaf:Capability/EdgeIngress'] },
              { k: 'composed_of', t: 'ref[]', v: ['acme:component/nginx', 'acme:component/oauth2-proxy'] },
            ],
          },
          {
            kind: 'swtech', name: 'SoftwareTechnology: APPLICATION_SERVER',
            uri: 'swtech:archetype/APPLICATION_SERVER/v1', since: '2024-09-15',
            facets: [{ kind: 'scap', name: 'ScapPlatformIdentifier', uri: 'gsmarc://gsm-frameworks/scap/cpe/ScapPlatformIdentifier/v1' }],
            slots: [
              { k: 'functional_type', t: 'enum', v: 'HTTP/gRPC server' },
              { k: 'runtime_engine', t: 'string', v: 'nginx 1.25' },
              { k: 'listens_on', t: 'string[]', v: ['443/tcp', '8443/tcp'] },
              { k: 'high_availability', t: 'enum', v: 'active-active' },
            ],
          },
          {
            kind: 'scap', name: 'ScapPlatformIdentifier',
            uri: 'gsmarc://gsm-frameworks/scap/cpe/ScapPlatformIdentifier/v1', since: '2024-12-01',
