    function getSubjectKey() {
      var p = new URLSearchParams(location.search);
      var k = p.get('subject') || 'api-gateway';
      return SUBJECTS[k] ? k : 'api-gateway';
    }

    function badgeFor(kind) {
      return '<span class="arc-badge arc-badge--' + kind + '">' + kind.toUpperCase() + '</span>';
    }
    function colorFor(kind) {
      return ({ togaf: '#1d4ed8', swtech: '#475569', iso: '#15803d', nis2: '#b91c1c', gdpr: '#7c3aed', scap: '#a16207', gsm: 'var(--itip-primary)' })[kind] || 'var(--itip-border)';
    }
    function checkFor(state) {
      var bg = state === 'pass' ? '#22c55e' : state === 'warn' ? '#f59e0b' : '#ef4444';
      var sym = state === 'pass' ? '✓' : state === 'warn' ? '!' : '✗';
      return '<span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:' + bg + ';color:#fff;font-size:11px;font-weight:700">' + sym + '</span>';
    }

    function primitiveTypeFromGsm(s) {
      var gsm = (s.primitive && s.primitive.gsm) || '';
      var m = gsm.match(/gsm\/([^/]+)\/v\d+/i);
      if (m) return m[1];
      var lbl = (s.primitive && s.primitive.label) || '';
      var fallback = lbl.split('·')[0].trim();
      return fallback || 'Definition';
    }
    function toKebab(raw) {
      return String(raw || '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'definition';
    }
    function toPascal(raw) {
      return String(raw || 'Mechanism')
        .replace(/[^a-zA-Z0-9]+/g, ' ')
        .split(' ')
        .filter(Boolean)
        .map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); })
        .join('') || 'Mechanism';
    }
    function primitiveSchemaSlots(s) {
      var pt = primitiveTypeFromGsm(s);
      var provided = s.primitiveFields || {};
      function inferType(v) {
        if (Array.isArray(v)) return 'array';
        if (typeof v === 'boolean') return 'bool';
        if (typeof v === 'number') return 'number';
        return 'string';
      }
      function slotsFromObject(obj) {
        return Object.keys(obj).map(function (k) {
          return { k: k, t: inferType(obj[k]), v: obj[k] };
        });
      }
      if (pt === 'Structure') {
        var purposeSeed = provided.purpose || String((s.uri || s.name || 'structure')).split(':').pop().replace(/\//g, '-');
        return [
          { k: 'purpose', t: 'string', v: toKebab(purposeSeed) },
        ];
      }
      if (pt === 'Mechanism') {
        var fn = provided['function'] || toPascal(s.name);
        var st = provided.structure || '019cc49a-dc5a-7003-98e1-c214032f0420';
        var rule = provided.rule || (
          'evt = on("' + fn + 'Requested")\n' +
          'if evt["id"] != "":\n' +
          '    sys.effect("' + fn + 'Processed", {"id": evt["id"]})'
        );
        return [
          { k: 'structure', t: 'uuid', v: st },
          { k: 'function', t: 'string', v: fn },
          { k: 'rule', t: 'string', v: rule },
        ];
      }
      if (pt === 'Interaction') {
        return [
          { k: 'effector', t: 'uuid', v: provided.effector || '019cc49a-dc5a-7a3b-909f-969bfe0d738e' },
          { k: 'receptor', t: 'uuid', v: provided.receptor || '019cc49a-dc5a-75ab-a4cb-e02d100e6c01' },
        ];
      }
      if (pt === 'Effector' || pt === 'Receptor') {
        return [
          { k: 'mechanism', t: 'uuid', v: provided.mechanism || '019cc49a-dc5a-76fd-94c7-8099ff821b3b' },
          { k: 'archetype', t: 'uuid', v: provided.archetype || '019cc49a-dc5a-7a45-a4d5-15b6033b2a62' },
        ];
      }
      if (pt === 'Directive') {
        var dPurposeSeed = provided.purpose || String((s.uri || s.name || 'directive')).split(':').pop().replace(/\//g, '-');
        return [
          { k: 'structure', t: 'uuid', v: provided.structure || '019cc49a-dc59-7fef-9b0c-b3f100044603' },
          { k: 'modal', t: 'enum', v: provided.modal || 'MUST' },
          { k: 'verb', t: 'enum', v: provided.verb || 'ENSURE' },
          { k: 'qualifier', t: 'uuid', v: provided.qualifier || '019cc49a-dc5a-7670-9ccb-5e161985340b' },
          { k: 'purpose', t: 'string', v: toKebab(dPurposeSeed) },
        ];
      }
      if (pt === 'Norm') {
        return [
          { k: 'structure', t: 'uuid', v: provided.structure || '019cc49a-dc59-7fef-9b0c-b3f100044603' },
          { k: 'qualifier', t: 'uuid', v: provided.qualifier || '019cc49a-dc5a-7670-9ccb-5e161985340b' },
          { k: 'applicability', t: 'string', v: provided.applicability || 'true' },
          { k: 'assertion', t: 'string', v: provided.assertion || 'SecurityProperties.tlsEnabled == true' },
          { k: 'toleranceMode', t: 'enum', v: provided.toleranceMode || 'INSTANTANEOUS' },
          { k: 'temporalWindow', t: 'duration', v: provided.temporalWindow || 'PT5M' },
          { k: 'temporalAggregation', t: 'enum', v: provided.temporalAggregation || 'P95' },
          { k: 'sustainedThreshold', t: 'number', v: provided.sustainedThreshold || 0.95 },
        ];
      }
      if (Object.keys(provided).length > 0) {
        return slotsFromObject(provided);
      }
      return [];
    }

    // Archetype graph: horizontal flow rendered into #arc-graph.
    // Per-slot archetype annotations — sourced from the framework JSON schemas
    // (itip/def/frameworks/<kind>/.../*.schema.json). Surface $gsm:* keywords, pattern,
    // enum, format, source, required, minLength inherited from the contributing archetype.
    var SLOT_ANNOTATIONS = {
      cpe_uri:          { '$schema': 'gsmarc://gsm/Structure/v1', type: 'string', pattern: '^cpe:2\\.3:[aoh*-]:', '$gsm:queryable': true, '$gsm:identityBound': true, required: true, source: 'NIST IR 7695 §5 (CPE 2.3 Formatted String Binding)' },
      vendor:           { type: 'string', minLength: 1, '$gsm:queryable': true, required: true, source: 'NIST IR 7695 §5.3.2' },
      product:          { type: 'string', minLength: 1, '$gsm:queryable': true, required: true, source: 'NIST IR 7695 §5.3.3' },
      version:          { type: 'string', '$gsm:queryable': true, source: 'NIST IR 7695 §5.3.4' },
      part:             { type: 'enum', enum: ['APPLICATION', 'OPERATING_SYSTEM', 'HARDWARE_DEVICE'], '$gsm:queryable': true, required: true, source: 'NIST IR 7695 §5.3.1' },
      vulnerability_feed: { type: 'uri', format: 'uri', source: 'SCAP / NVD feed reference' },
      scan_cadence:     { type: 'duration', format: 'ISO-8601 duration', source: 'SCAP Reporting Cadence' },
      architectureTier: { type: 'enum', enum: ['PRESENTATION', 'APPLICATION', 'DATA', 'INTEGRATION'], '$gsm:queryable': true, required: true, source: 'TOGAF Application Architecture (Content Metamodel)' },
      functionalDomain: { type: 'string', minLength: 1, '$gsm:queryable': true, source: 'TOGAF Application Architecture (Content Metamodel)' },
      domain:           { type: 'string', '$gsm:queryable': true, source: 'TOGAF Content Metamodel' },
      component_type:   { type: 'enum', enum: ['Logical', 'Physical'], '$gsm:queryable': true, source: 'TOGAF Content Metamodel' },
      realises:         { type: 'array<ref>', '$gsm:queryable': true, source: 'TOGAF Content Metamodel (realisation relationship)' },
      composed_of:      { type: 'array<ref>', '$gsm:queryable': true, source: 'TOGAF Content Metamodel (composition relationship)' },
      purpose:          { '$schema': 'gsmarc://gsm/Structure/v1', type: 'string', pattern: '^[a-z][a-z0-9]*(-[a-z0-9]+)*$', '$gsm:identityBound': true, required: true, source: 'GSM Structure schema' },
      structure:        { '$schema': 'gsmarc://gsm/Mechanism/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Mechanism schema' },
      function:         { '$schema': 'gsmarc://gsm/Mechanism/v1', type: 'string', minLength: 1, '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Mechanism schema' },
      rule:             { '$schema': 'gsmarc://gsm/Mechanism/v1', type: 'string', minLength: 1, required: true, source: 'GSM Mechanism schema' },
      effector:         { '$schema': 'gsmarc://gsm/Interaction/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Interaction schema' },
      receptor:         { '$schema': 'gsmarc://gsm/Interaction/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Interaction schema' },
      mechanism:        { '$schema': 'gsmarc://gsm/Effector/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Effector/Receptor schema' },
      archetype:        { '$schema': 'gsmarc://gsm/Effector/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Effector/Receptor schema' },
      modal:            { '$schema': 'gsmarc://gsm/Directive/v1', type: 'enum', enum: ['MUST', 'MUST_NOT', 'SHOULD', 'SHOULD_NOT', 'MAY'], required: true, source: 'GSM Directive schema' },
      verb:             { '$schema': 'gsmarc://gsm/Directive/v1', type: 'enum', enum: ['ENSURE', 'PREVENT', 'MAINTAIN', 'OPTIMIZE', 'MINIMIZE', 'MAXIMIZE', 'MONITOR', 'ENABLE'], required: true, source: 'GSM Directive schema' },
      qualifier:        { '$schema': 'gsmarc://gsm/Directive/v1', type: 'string', format: 'uuid', '$gsm:identityBound': true, '$gsm:queryable': true, required: true, source: 'GSM Directive/Norm schema' },
      applicability:    { '$schema': 'gsmarc://gsm/Norm/v1', type: 'string', source: 'GSM Norm schema (default true)' },
      assertion:        { '$schema': 'gsmarc://gsm/Norm/v1', type: 'string', '$gsm:identityBound': true, required: true, source: 'GSM Norm schema' },
      toleranceMode:    { '$schema': 'gsmarc://gsm/Norm/v1', type: 'enum', enum: ['INSTANTANEOUS', 'AGGREGATED', 'SUSTAINED'], required: true, source: 'GSM Norm schema' },
      temporalWindow:   { '$schema': 'gsmarc://gsm/Norm/v1', type: 'duration', format: 'ISO-8601 duration', source: 'GSM Norm schema' },
      temporalAggregation: { '$schema': 'gsmarc://gsm/Norm/v1', type: 'enum', enum: ['SUM', 'AVG', 'MIN', 'MAX', 'COUNT', 'P50', 'P90', 'P95', 'P99'], source: 'GSM Norm schema' },
      sustainedThreshold: { '$schema': 'gsmarc://gsm/Norm/v1', type: 'number', source: 'GSM Norm schema' },
      lawful_basis:     { type: 'enum', enum: ['CONSENT', 'CONTRACT', 'LEGAL_OBLIGATION', 'VITAL_INTERESTS', 'PUBLIC_TASK', 'LEGITIMATE_INTERESTS'], '$gsm:queryable': true, required: true, source: 'GDPR Art. 6(1)' },
      data_categories:  { type: 'array<string>', '$gsm:queryable': true, source: 'GDPR Art. 4(1)' },
      retention_max:    { type: 'duration', format: 'ISO-8601 duration', '$gsm:queryable': true, source: 'GDPR Art. 5(1)(e)' },
      special_category: { type: 'bool', '$gsm:queryable': true, source: 'GDPR Art. 9' },
      controller:       { type: 'string', '$gsm:queryable': true, source: 'GDPR Art. 4(7)' },
      processor:        { type: 'string', '$gsm:queryable': true, source: 'GDPR Art. 4(8)' },
      essential_service: { type: 'bool', '$gsm:queryable': true, source: 'NIS2 Annex I' },
      incident_threshold: { type: 'string', '$gsm:queryable': true, source: 'NIS2 Art. 23 (reporting thresholds)' }
    };

    function annotateSlot(sl, archetype) {
      var base = {
        '$ref': archetype.uri || 'gsmarc://gsm-frameworks/' + archetype.kind + '/' + archetype.name + '/v1',
        type: sl.t
      };
      var known = SLOT_ANNOTATIONS[sl.k] || SLOT_ANNOTATIONS[sl.k.toLowerCase()] || {};
      var ann = Object.assign({}, base, known);
      // Defaults inferred from the slot's runtime type when unspecified
      if (!ann.format) {
        if (sl.t === 'uri') ann.format = 'uri';
        else if (sl.t === 'duration') ann.format = 'ISO-8601 duration';
        else if (sl.t === 'datetime') ann.format = 'date-time';
      }
      if (ann['$gsm:queryable'] === undefined && (sl.t === 'enum' || sl.t === 'uri' || sl.t === 'ref' || sl.t === 'string')) {
        ann['$gsm:queryable'] = true;
      }
      return ann;
    }

    function getAscriptionId(s) {
      var p = new URLSearchParams(location.search);
      var a = p.get('ascription');
      if (a && s.ascriptions && s.ascriptions.some(function (x) { return x.id === a; })) return a;
      return s.ascriptions && s.ascriptions.length ? s.ascriptions[0].id : null;
    }

    function render() {
      var key = getSubjectKey();
      var s = SUBJECTS[key];
      var ascId = getAscriptionId(s);
      var ascList = s.ascriptions || [];
      var asc = ascList.find(function (x) { return x.id === ascId; }) || { id: '—', state: s.state || 'active', created: s.created };
      var primitiveType = primitiveTypeFromGsm(s);

      document.getElementById('bc-subject').textContent = s.name;
      document.getElementById('title-subject').textContent = primitiveType + ' Definition';
      document.getElementById('auth-owner').textContent = s.owner;
      document.getElementById('auth-created').textContent = s.created;
      document.getElementById('auth-updated').textContent = s.updated;

      // Single ascription/statement lifecycle
      var NEXT = {
        draft: ['proposed', 'abandoned'],
        proposed: ['approved', 'rejected', 'draft'],
        approved: ['active', 'proposed'],
        active: ['suspended', 'deprecated'],
        suspended: ['active', 'deprecated'],
        deprecated: ['retired'],
        retired: [],
        rejected: [],
        abandoned: [],
      };
      function stateLabel(st) { return st.charAt(0).toUpperCase() + st.slice(1); }

      // Render ascription switcher (with compare-mode diff selection)
      document.getElementById('asc-count').textContent = ascList.length ? '(' + ascList.length + ')' : '';
      var switcherEl = document.getElementById('asc-switcher');
      var toggleEl = document.getElementById('asc-compare-toggle');
      var toolbarEl = document.getElementById('asc-diff-toolbar');
      var hintEl = document.getElementById('asc-hint');
      var diffHintEl = document.getElementById('asc-diff-hint');
      var diffPairEl = document.getElementById('asc-diff-pair');
      var diffOpenBtn = document.getElementById('asc-diff-open');
      var diffClearBtn = document.getElementById('asc-diff-clear');
      var compareMode = false;
      // Pre-select the current ascription when the user enters compare mode.
      var selected = [];

      function renderSwitcher() {
        switcherEl.className = 'asc-switcher' + (compareMode ? ' asc-switcher--compare' : '');
        switcherEl.innerHTML = ascList.map(function (a) {
          var cur = a.id === asc.id;
          var sel = selected.indexOf(a.id) !== -1;
          var classes = 'asc-pill';
          if (cur) classes += ' asc-pill--current';
          if (sel) classes += ' asc-pill--selected';
          var check = compareMode
            ? '<span class="asc-pill__check" aria-hidden="true">' + (sel ? '\u2713' : '') + '</span>'
            : '';
          var inner =
            check +
            '<span class="asc-pill__id">' + a.id + '</span>' +
            '<span class="asc-pill__state"><span class="stmt-state stmt-state--' + a.state + '">' + stateLabel(a.state) + '</span></span>' +
            '<span class="asc-pill__created">' + a.created + '</span>';
          if (compareMode) {
            return '<button type="button" class="' + classes + '" data-asc-id="' + a.id + '" aria-pressed="' + sel + '">' + inner + '</button>';
          }
          return '<a class="' + classes + '" href="?subject=' + key + '&ascription=' + a.id + '">' + inner + '</a>';
        }).join('');
        if (compareMode) {
          switcherEl.querySelectorAll('.asc-pill').forEach(function (btn) {
            btn.addEventListener('click', function () { toggleSelect(btn.getAttribute('data-asc-id')); });
          });
        }
      }

      function renderToolbar() {
        if (!compareMode) { toolbarEl.hidden = true; return; }
        toolbarEl.hidden = false;
        var n = selected.length;
        if (n === 0) {
          diffHintEl.textContent = 'Select two ascriptions to compare (max 2).';
          diffPairEl.hidden = true;
          diffOpenBtn.disabled = true;
        } else if (n === 1) {
          diffHintEl.textContent = 'Select one more to compare.';
          diffPairEl.hidden = true;
          diffOpenBtn.disabled = true;
        } else {
          diffHintEl.textContent = 'Ready to compare:';
          diffPairEl.hidden = false;
          // Order by ascList position so older → newer reads naturally.
          var ordered = ascList.map(function (a) { return a.id; }).filter(function (id) { return selected.indexOf(id) !== -1; });
          var from = ordered[ordered.length - 1]; // older (later in list)
          var to = ordered[0];                    // newer (first in list)
          diffPairEl.innerHTML = '<span>' + from + '</span><span class="asc-diff-arrow">→</span><span>' + to + '</span>';
          diffOpenBtn.disabled = false;
          diffOpenBtn.onclick = function () {
            window.location.href = 'ascription-diff.html?subject=' + encodeURIComponent(key) + '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to);
          };
        }
      }

      function toggleSelect(id) {
        var i = selected.indexOf(id);
        if (i !== -1) {
          selected.splice(i, 1);
        } else {
          if (selected.length >= 2) selected.shift(); // FIFO: drop oldest selection
          selected.push(id);
        }
        renderSwitcher();
        renderToolbar();
      }

      function setCompareMode(on) {
        compareMode = on;
        toggleEl.classList.toggle('asc-compare-toggle--on', on);
        toggleEl.setAttribute('aria-pressed', String(on));
        hintEl.textContent = on
          ? 'Pick two ascriptions to diff. The current one is pre-selected.'
          : 'Switch between historical and current ascriptions of this subject.';
        if (on && selected.length === 0) selected = [asc.id];
        renderSwitcher();
        renderToolbar();
      }

      toggleEl.addEventListener('click', function () { setCompareMode(!compareMode); });
      diffClearBtn.addEventListener('click', function () { selected = []; renderSwitcher(); renderToolbar(); });

      renderSwitcher();

      var st = asc.state;

      var nexts = NEXT[st] || [];

      // Render status state machine in sidebar (compact SVG sized for the narrow column).
      // Layout: vertical spine (Draft → Proposed → Approved → Active → Deprecated → Retired)
      // plus side branches for Abandoned, Rejected (terminals) and the Suspended ↔ Active loop.
      var reachable = new Set(nexts);
      var curPill = document.getElementById('lc-current-pill');
      curPill.className = 'stmt-state stmt-state--' + st;
      curPill.textContent = stateLabel(st);

      (function renderStateMachine() {
        var container = document.getElementById('sm-machine');
        if (!container) return;

        var NODE_W = 102, NODE_H = 26, RX = 6;
        var SPINE_X = 14;
        var SIDE_X = SPINE_X + NODE_W + 36;
        var ROW_GAP = 56;
        var TOP_PAD = 16;
        var rows = {
          draft:      TOP_PAD + 0 * ROW_GAP,
          proposed:   TOP_PAD + 1 * ROW_GAP,
          approved:   TOP_PAD + 2 * ROW_GAP,
          active:     TOP_PAD + 3 * ROW_GAP,
          deprecated: TOP_PAD + 4 * ROW_GAP,
          retired:    TOP_PAD + 5 * ROW_GAP,
        };
        var nodes = [
          { id: 'draft',      x: SPINE_X, y: rows.draft,      label: 'DRAFT' },
          { id: 'proposed',   x: SPINE_X, y: rows.proposed,   label: 'PROPOSED' },
          { id: 'approved',   x: SPINE_X, y: rows.approved,   label: 'APPROVED' },
          { id: 'active',     x: SPINE_X, y: rows.active,     label: 'ACTIVE' },
          { id: 'deprecated', x: SPINE_X, y: rows.deprecated, label: 'DEPRECATED' },
          { id: 'retired',    x: SPINE_X, y: rows.retired,    label: 'RETIRED',    terminal: true },
          { id: 'abandoned',  x: SIDE_X,  y: rows.draft,      label: 'ABANDONED',  terminal: true },
          { id: 'rejected',   x: SIDE_X,  y: rows.proposed,   label: 'REJECTED',   terminal: true },
          { id: 'suspended',  x: SIDE_X,  y: rows.active,     label: 'SUSPENDED' },
        ];
        var W = SIDE_X + NODE_W + 14;
        var H = rows.retired + NODE_H + TOP_PAD;

        function leftMid(n)   { return { x: n.x,            y: n.y + NODE_H / 2 }; }
        function rightMid(n)  { return { x: n.x + NODE_W,   y: n.y + NODE_H / 2 }; }
        function topMid(n)    { return { x: n.x + NODE_W/2, y: n.y }; }
        function bottomMid(n) { return { x: n.x + NODE_W/2, y: n.y + NODE_H }; }
        var byId = {};
        nodes.forEach(function (n) { byId[n.id] = n; });

        function vSpine(fromId, toId) {
          var a = bottomMid(byId[fromId]), b = topMid(byId[toId]);
          return { from: fromId, to: toId, d: 'M ' + a.x + ' ' + a.y + ' L ' + b.x + ' ' + b.y };
        }
        function rightBranch(fromId, toId) {
          var a = rightMid(byId[fromId]), b = leftMid(byId[toId]);
          return { from: fromId, to: toId, d: 'M ' + a.x + ' ' + a.y + ' L ' + b.x + ' ' + b.y };
        }
        function loopRightTo(fromId, toId, dy) {
          var a = rightMid(byId[fromId]); a.y += dy;
          var b = leftMid(byId[toId]);    b.y += dy;
          return { from: fromId, to: toId, d: 'M ' + a.x + ' ' + a.y + ' L ' + b.x + ' ' + b.y };
        }
        function loopLeftTo(fromId, toId, dy) {
          var a = leftMid(byId[fromId]); a.y += dy;
          var b = rightMid(byId[toId]);  b.y += dy;
          return { from: fromId, to: toId, d: 'M ' + a.x + ' ' + a.y + ' L ' + b.x + ' ' + b.y };
        }

        var edges = [
          vSpine('draft', 'proposed'),
          vSpine('proposed', 'approved'),
          vSpine('approved', 'active'),
          vSpine('active', 'deprecated'),
          vSpine('deprecated', 'retired'),
          rightBranch('draft', 'abandoned'),
          rightBranch('proposed', 'rejected'),
          loopRightTo('active', 'suspended', -4),
          loopLeftTo('suspended', 'active', 4),
        ];

        var defs =
          '<defs>' +
            '<marker id="sm-arrow" markerUnits="userSpaceOnUse" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto">' +
              '<polygon points="0 0, 7 3, 0 6" fill="currentColor"/>' +
            '</marker>' +
          '</defs>';

        var edgesSvg = edges.map(function (e) {
          var isReachable = e.from === st && reachable.has(e.to);
          var cls = 'sm-edge' + (isReachable ? ' sm-edge--reachable' : '');
          var color = isReachable ? 'var(--itip-primary)' : 'var(--itip-text-muted)';
          return '<g style="color:' + color + '"><path class="' + cls + '" d="' + e.d + '" marker-end="url(#sm-arrow)"/></g>';
        }).join('');

        var nodesSvg = nodes.map(function (n) {
          var isCurrent = n.id === st;
          var isReachable = !isCurrent && reachable.has(n.id);
          var cls = 'sm-node';
          if (isCurrent) cls += ' sm-node--current';
          else if (n.terminal) cls += ' sm-node--terminal';
          if (isReachable) cls += ' sm-node--reachable';
          var dataAttrs = isReachable ? ' data-target="' + n.id + '"' : '';
          var titleEl = isReachable
            ? '<title>Transition ' + stateLabel(st) + ' → ' + stateLabel(n.id) + '</title>'
            : (isCurrent ? '<title>Current state</title>' : '');
          return '<g class="' + cls + '"' + dataAttrs + '>' +
            titleEl +
            '<rect x="' + n.x + '" y="' + n.y + '" width="' + NODE_W + '" height="' + NODE_H + '" rx="' + RX + '" ry="' + RX + '"/>' +
            '<text x="' + (n.x + NODE_W / 2) + '" y="' + (n.y + NODE_H / 2 + 3.5) + '" text-anchor="middle">' + n.label + '</text>' +
            '</g>';
        }).join('');

        var labelsHtml = nodes.map(function (n) {
          var isCurrent = n.id === st;
          var isReachable = !isCurrent && reachable.has(n.id);
          var cls = 'sm-node-label';
          if (isCurrent) cls += ' sm-node-label--current';
          else if (isReachable) cls += ' sm-node-label--reachable';
          else if (n.terminal) cls += ' sm-node-label--terminal';
          var style = 'left:' + n.x + 'px;top:' + n.y + 'px;width:' + NODE_W + 'px;height:' + NODE_H + 'px;';
          return '<div class="' + cls + '" style="' + style + '">' + n.label + '</div>';
        }).join('');

        container.innerHTML =
          '<div class="sm-machine-stage">' +
            '<svg class="sm-svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">' +
            defs + edgesSvg + nodesSvg +
            '</svg>' +
            labelsHtml +
          '</div>';

        container.querySelectorAll('.sm-node--reachable').forEach(function (g) {
          g.addEventListener('click', function () {
            var target = g.getAttribute('data-target');
            if (typeof window.__stageTransition === 'function') {
              window.__stageTransition(target);
            }
            // Switch to Status transition tab
            document.querySelectorAll('#def-tabs .deftab').forEach(function (b) {
              b.classList.toggle('deftab--active', b.getAttribute('data-deftab') === 'status');
            });
            document.querySelectorAll('.deftabpanel').forEach(function (p) {
              p.classList.toggle('deftabpanel--active', p.id === 'deftabpanel-status');
            });
            var panel = document.getElementById('deftabpanel-status');
            if (panel && panel.scrollIntoView) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });
      })();

      // Statement section: render base archetype + each framework archetype as arc-cards
      function arcSlug(name) { return String(name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''); }

      // Synthesize the base archetyped statement (the GSM primitive itself)
      var baseArchetype = {
        kind: 'gsm',
        name: s.primitive.gsm,
        uri: 'gsm:archetype/' + s.primitive.gsm,
        slots: primitiveSchemaSlots(s).concat([
          { k: 'subject_uri', t: 'uri', v: s.uri },
          { k: 'display_name', t: 'string', v: s.name },
          { k: 'gsm_primitive', t: 'string', v: s.primitive.label },
        ]),
      };
      var allArchetypes = [baseArchetype].concat(s.archetypes);

      function renderArcCard(a) {
        var slotsHtml = (a.slots || []).map(function (sl, idx) {
          var val;
          var valClass = sl.k === 'name' ? 'slot-val slot-val--name' : 'slot-val';
          if (Array.isArray(sl.v)) {
            val = sl.v.map(function (x) {
              return '<code class="' + valClass + '">' + x + '</code>';
            }).join(' ');
          } else if (sl.t === 'uri' || sl.t === 'ref') {
            val = '<code class="' + valClass + '">' + sl.v + '</code>';
          } else if (sl.t === 'duration' || sl.t === 'number' || sl.t === 'bool') {
            val = '<code class="' + valClass + '">' + sl.v + '</code>';
          } else {
            val = '<span class="' + valClass + '">' + sl.v + '</span>';
          }
          var ann = annotateSlot(sl, a);
          var metaRows = Object.keys(ann).map(function (k) {
            var v = ann[k];
            var rendered;
            if (typeof v === 'boolean') {
              rendered = v
                ? '<span class="slot-meta__bool--yes">true</span>'
                : '<span class="slot-meta__bool--no">false</span>';
            } else if (Array.isArray(v)) {
              rendered = v.map(function (x) { return '<code>' + x + '</code>'; }).join(' ');
            } else if (k === 'pattern' || k === '$schema' || k === '$ref' || k === 'format' || k === 'type') {
              rendered = '<code>' + v + '</code>';
            } else {
              rendered = String(v);
            }
            return '<span class="slot-meta__k">' + k + '</span>' +
              '<span class="slot-meta__v">' + rendered + '</span>';
          }).join('');
          var slotId = 'slot-meta-' + a.kind + '-' + idx;
          return '<div class="slot-row">' +
            '<span class="slot-key">' +
              '<span class="slot-key__toggle" data-target="' + slotId + '">▸</span>' +
              sl.k +
            '</span>' +
            '<span class="slot-value">' + val + '</span>' +
            '<div class="slot-meta" id="' + slotId + '">' + metaRows + '</div>' +
            '</div>';
        }).join('');
        return '<div class="arc-card arc-nav-target" id="arc-card-' + arcSlug(a.name) + '" style="border-left-color:' + colorFor(a.kind) + '">' +
          '<div class="arc-card__rail">' + badgeFor(a.kind) +
            '<code class="arc-card__uri">' + (a.uri || '') + '</code>' +
          '</div>' +
          '<div class="arc-card__body">' +
            '<div class="slot-table">' + slotsHtml + '</div>' +
          '</div>' +
          '</div>';
      }

      var baseHtml = renderArcCard(baseArchetype);
      var extendsHtml = '';
      if (s.archetypes && s.archetypes.length > 0) {
        // Split: facet archetypes are those whose URI is referenced in another
        // archetype's facets[] (allOf composition). Render them nested under
        // their parent; everything else is a sibling $ref extension of the base.
        var byUri = {};
        s.archetypes.forEach(function (a) { if (a.uri) byUri[a.uri] = a; });
        var facetParentOf = {}; // childUri -> parentArchetype
        s.archetypes.forEach(function (parent) {
          (parent.facets || []).forEach(function (f) {
            if (f.uri && byUri[f.uri]) {
              facetParentOf[f.uri] = parent;
            }
          });
        });
        var siblings = s.archetypes.filter(function (a) { return !facetParentOf[a.uri]; });
        function renderWithFacets(parent) {
          var html = renderArcCard(parent);
          var children = (parent.facets || [])
            .map(function (f) { return byUri[f.uri]; })
            .filter(Boolean);
          if (children.length > 0) {
            html +=
              '<div class="arc-facets">' +
                children.map(renderArcCard).join('') +
              '</div>';
          }
          return html;
        }
        extendsHtml =
          '<div class="arc-extends">' +
            siblings.map(renderWithFacets).join('') +
          '</div>';
      }
      document.getElementById('arc-list').innerHTML = baseHtml + extendsHtml;

      // Render UML edges: generalization (IS A) and aggregation (HAS A)
      function renderUMLEdges() {
        var svg = document.getElementById('arc-edges');
        var container = svg.parentElement;
        var bbox = container.getBoundingClientRect();
        svg.setAttribute('width', bbox.width);
        svg.setAttribute('height', bbox.height);
        svg.innerHTML = '<defs>' +
          '<marker id="uml-generalization" viewBox="0 0 8 8" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto">' +
            '<path d="M0 0 L8 4 L0 8 Z" fill="white" stroke="#8b949e" stroke-width="1.2" stroke-linejoin="miter"/>' +
          '</marker>' +
          '<marker id="uml-aggregation" viewBox="0 0 8 8" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">' +
            '<path d="M0 4 L4 0 L8 4 L4 8 Z" fill="white" stroke="#8b949e" stroke-width="1.2" stroke-linejoin="miter"/>' +
          '</marker>' +
        '</defs>';
        
        var baseCard = document.querySelector('.arc-card');
        if (!baseCard) return;
        var baseRect = baseCard.getBoundingClientRect();
        var baseLeft = baseRect.left - bbox.left;
        var baseBottomY = baseRect.top - bbox.top + baseRect.height;

        // IS A edges: $ref children → base archetype (generalization with hollow triangle at base bottom)
        document.querySelectorAll('.arc-extends > .arc-card').forEach(function(child) {
          var childRect = child.getBoundingClientRect();
          var childLeft = childRect.left - bbox.left;
          var childMidY = childRect.top - bbox.top + childRect.height / 2;
          var axisX = childLeft - 30;
          var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          var d = 'M' + childLeft + ' ' + childMidY + ' L' + axisX + ' ' + childMidY + ' L' + axisX + ' ' + baseBottomY;
          path.setAttribute('d', d);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', '#8b949e');
          path.setAttribute('stroke-width', '1.5');
          path.setAttribute('marker-end', 'url(#uml-generalization)');
          svg.appendChild(path);
        });

        // HAS A edges: parent archetype → allOf facets (aggregation with hollow diamond at facet)
        document.querySelectorAll('.arc-facets').forEach(function(facetsGroup) {
          var parentCard = facetsGroup.previousElementSibling;
          if (!parentCard || !parentCard.classList.contains('arc-card')) return;
          var parentRect = parentCard.getBoundingClientRect();
          var parentLeft = parentRect.left - bbox.left;
          var parentMidY = parentRect.top - bbox.top + parentRect.height / 2;
          facetsGroup.querySelectorAll('.arc-card').forEach(function(facet) {
            var facetRect = facet.getBoundingClientRect();
            var facetLeft = facetRect.left - bbox.left;
            var facetMidY = facetRect.top - bbox.top + facetRect.height / 2;
            var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            var d = 'M' + parentLeft + ' ' + parentMidY + ' L' + (facetLeft - 30) + ' ' + parentMidY + ' L' + (facetLeft - 30) + ' ' + facetMidY + ' L' + (facetLeft - 1) + ' ' + facetMidY;
            path.setAttribute('d', d);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', '#8b949e');
            path.setAttribute('stroke-width', '1.5');
            path.setAttribute('marker-end', 'url(#uml-aggregation)');
            svg.appendChild(path);
          });
        });
      }
      setTimeout(renderUMLEdges, 50);

      // Wire up slot-meta toggles
      document.querySelectorAll('.slot-key__toggle').forEach(function (tog) {
        tog.addEventListener('click', function () {
          var target = document.getElementById(tog.getAttribute('data-target'));
          if (!target) return;
          var open = target.classList.toggle('slot-meta--open');
          tog.textContent = open ? '▾' : '▸';
        });
      });

      // Norms
      document.getElementById('norm-list').innerHTML = s.norms.map(function (n) {
        return '<div class="norm-row"><span class="norm-row__name">' + n.name + '</span>' +
          '<span class="text-xs" style="text-align:center">' + n.from + '</span>' +
          '<span style="text-align:center">' + checkFor(n.state) + '</span></div>';
      }).join('');

      // Activity timeline
      document.getElementById('activity-list').innerHTML = s.activity.map(function (a) {
        return '<div class="timeline-item' + (a.current ? ' timeline-item--current' : '') + '">' +
          '<div class="timeline-time">' + a.time + '</div>' +
          '<div class="timeline-title">' + a.title + '</div>' +
          '<div class="text-xs text-muted">' + a.meta + '</div></div>';
      }).join('');

      // Highlight active switcher
      var sw = document.querySelectorAll('.subject-switcher a');
      sw.forEach(function (a) {
        a.classList.toggle('active', a.dataset.subject === key);
      });
      document.title = primitiveType + ' Definition';

      // Render Schema tab graph (depth = 1)
      renderSchemaGraph(s);
    }

    // Tabs wiring (main column)
    document.querySelectorAll('#def-tabs .deftab').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.getAttribute('data-deftab');
        document.querySelectorAll('#def-tabs .deftab').forEach(function (b) {
          b.classList.toggle('deftab--active', b === btn);
        });
        document.querySelectorAll('.deftabpanel').forEach(function (p) {
          p.classList.toggle('deftabpanel--active', p.id === 'deftabpanel-' + key);
        });
      });
    });

    // Status-transition staging: wire confirm/reset buttons + expose staging hook
    // for the sidebar lifecycle state machine to call when a reachable state is clicked.
    (function wireTransitionStaging() {
      var fromEl = document.getElementById('tx-from');
      var toEl = document.getElementById('tx-to');
      var precondEl = document.getElementById('tx-precond-desc');
      var confirmBtn = document.getElementById('tx-confirm-btn');
      var cancelBtn = document.getElementById('tx-cancel-btn');
      var banner = document.getElementById('tx-confirm-banner');

      var current = 'APPROVED';
      var defaultTarget = 'ACTIVE';
      var target = defaultTarget;

      function paint() {
        if (fromEl) fromEl.textContent = current;
        if (toEl) {
          toEl.textContent = target || '—';
          toEl.style.visibility = target ? 'visible' : 'hidden';
        }
        if (precondEl) {
          precondEl.innerHTML = target
            ? (current + ' \u2192 ' + target + ' requires each reference in <strong>' + target + '</strong>')
            : 'Select a reachable target state on the diagram.';
        }
        if (confirmBtn) confirmBtn.disabled = !target;
      }

      // Public hook: called by sidebar SM click handler.
      window.__stageTransition = function (targetState) {
        target = String(targetState || '').toUpperCase();
        if (banner) banner.hidden = true;
        paint();
      };

      if (cancelBtn) cancelBtn.addEventListener('click', function () {
        target = defaultTarget;
        if (banner) banner.hidden = true;
        paint();
      });
      if (confirmBtn) confirmBtn.addEventListener('click', function () {
        if (!target) return;
        if (!window.confirm('Confirm transition ' + current + ' \u2192 ' + target + '?')) return;
        if (banner) {
          banner.textContent = 'Transition confirmed (mock): ' + current + ' \u2192 ' + target + '. Backend call would be issued here.';
          banner.hidden = false;
        }
      });

      paint();
    })();

    // Depth-1 schema graph: center node = this subject; satellites = related[] entries.
    // Each satellite is connected by an edge labeled with the relation (`via`).
    function renderSchemaGraph(s) {
      var svg = document.getElementById('schema-graph-svg');
      if (!svg) return;
      while (svg.firstChild) svg.removeChild(svg.firstChild);

      var W = svg.clientWidth || 720;
      var H = 360;
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

      var NS = 'http://www.w3.org/2000/svg';
      function el(name, attrs, text) {
        var n = document.createElementNS(NS, name);
        Object.keys(attrs || {}).forEach(function (k) { n.setAttribute(k, attrs[k]); });
        if (text != null) n.textContent = text;
        return n;
      }

      // Arrow marker
      var defs = el('defs', {});
      var marker = el('marker', {
        id: 'sg-arrow', viewBox: '0 0 8 8', refX: '7', refY: '4',
        markerWidth: '7', markerHeight: '6', orient: 'auto', markerUnits: 'userSpaceOnUse'
      });
      marker.appendChild(el('path', { d: 'M0,0 L8,4 L0,8 z', fill: 'var(--itip-text-muted)' }));
      defs.appendChild(marker);
      svg.appendChild(defs);

      var cx = W / 2, cy = H / 2;
      var nodes = (s.related || []).slice(0, 8);
      var n = nodes.length;
      var radius = Math.min(W, H) * 0.36;

      // Edges first (so they sit behind nodes)
      nodes.forEach(function (r, i) {
        var angle = (-Math.PI / 2) + (i * (2 * Math.PI / Math.max(n, 1)));
        var x = cx + radius * Math.cos(angle);
        var y = cy + radius * Math.sin(angle);
        // shorten endpoints so the arrow tip doesn't overlap nodes
        var dx = x - cx, dy = y - cy;
        var len = Math.sqrt(dx * dx + dy * dy) || 1;
        var ux = dx / len, uy = dy / len;
        var sx = cx + ux * 46, sy = cy + uy * 18;
        var ex = x - ux * 60, ey = y - uy * 16;
        svg.appendChild(el('line', {
          x1: sx, y1: sy, x2: ex, y2: ey,
          stroke: 'var(--itip-text-muted)', 'stroke-width': '1', 'stroke-dasharray': '4 3',
          'marker-end': 'url(#sg-arrow)'
        }));
        // edge label
        var lx = (sx + ex) / 2, ly = (sy + ey) / 2;
        var labelW = Math.max(40, r.via.length * 6.5);
        svg.appendChild(el('rect', {
          x: lx - labelW / 2, y: ly - 8, width: labelW, height: 16,
          rx: 8, ry: 8, fill: 'var(--itip-surface)', stroke: 'var(--itip-border)'
        }));
        svg.appendChild(el('text', {
          x: lx, y: ly + 4, 'text-anchor': 'middle',
          'font-size': '10', 'font-family': 'var(--font-base)',
          fill: 'var(--itip-text-muted)'
        }, r.via));
      });

      // Center node (this subject)
      var centerW = Math.max(120, (s.name || '').length * 7 + 28);
      svg.appendChild(el('rect', {
        x: cx - centerW / 2, y: cy - 22, width: centerW, height: 44,
        rx: 8, ry: 8,
        fill: 'color-mix(in srgb, var(--itip-primary) 10%, var(--itip-surface))',
        stroke: 'var(--itip-primary)', 'stroke-width': '2'
      }));
      svg.appendChild(el('text', {
        x: cx, y: cy - 4, 'text-anchor': 'middle',
        'font-size': '12', 'font-weight': '600', fill: 'var(--itip-text)'
      }, s.name));
      svg.appendChild(el('text', {
        x: cx, y: cy + 12, 'text-anchor': 'middle',
        'font-size': '10', fill: 'var(--itip-text-muted)'
      }, s.primitive ? s.primitive.label : ''));

      // Satellite nodes
      nodes.forEach(function (r, i) {
        var angle = (-Math.PI / 2) + (i * (2 * Math.PI / Math.max(n, 1)));
        var x = cx + radius * Math.cos(angle);
        var y = cy + radius * Math.sin(angle);
        var w = Math.max(110, (r.name || '').length * 6.5 + 24);
        var g = el('g', { style: 'cursor:pointer' });
        var rect = el('rect', {
          x: x - w / 2, y: y - 16, width: w, height: 32,
          rx: 6, ry: 6,
          fill: 'var(--itip-surface)', stroke: '#64748b', 'stroke-width': '1'
        });
        var txt = el('text', {
          x: x, y: y + 4, 'text-anchor': 'middle',
          'font-size': '11', fill: 'var(--itip-text)'
        }, r.name);
        g.appendChild(rect); g.appendChild(txt);
        g.addEventListener('click', function () {
          window.location.search = '?subject=' + r.subject;
        });
        svg.appendChild(g);
      });

      if (n === 0) {
        svg.appendChild(el('text', {
          x: cx, y: cy + 50, 'text-anchor': 'middle',
          'font-size': '11', fill: 'var(--itip-text-muted)'
        }, 'No depth-1 neighbors for this subject.'));
      }
    }

    render();
  </script>
</body>

</html>
